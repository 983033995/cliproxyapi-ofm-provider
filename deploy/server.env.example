# Server-side only: these values are read by the CLIProxyAPI server process.
# Never commit real secrets. Restrict deployment secret file to root / CLIProxyAPI service user.
OFM_ACCOUNT_GATEWAY_URL=http://127.0.0.1:18900
OFM_ACCOUNT_FORWARD_KEY=REPLACE_WITH_RUNTIME_FORWARD_KEY
OFM_PROVIDERS_FILE=/var/lib/cliproxyapi/ofm-providers.json
OFM_SECRETS_FILE=/var/lib/cliproxyapi/ofm.secrets.json
